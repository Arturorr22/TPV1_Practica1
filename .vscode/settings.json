{
    // Opciones de configuración de CMake (en CMake Tools de VS Code)
    "cmake.configureSettings": {
    	// Activa el comprobador de errores de memoria
        "ENABLE_ASAN": false
    },
    // Opciones de configuración de las ejecuciones de CMake Tools
    "cmake.debugConfig": {  
        "environment": [{
	    // Añade las rutas de las bibliotecas al PATH para que encuentre las DLL
            "name": "PATH",
            "value": "${env:PATH};${workspaceFolder}/libs/SDL3/lib;${workspaceFolder}/libs/SDL3_image/lib"
        }],
        "console": "integratedTerminal"
    },
}
