{
    // Configuración para ejecución de la plantilla SDL
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (C++ tools)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}/build",
            "windows": {
                "environment": [{
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}/libs/SDL3/lib;${workspaceFolder}/libs/SDL3_image/lib"
                }]
            },
            "console": "integratedTerminal"
        }
    ]
}
